# Set default behavior to automatically normalize line endings.
* text=auto

# Localization checks compare generated JSON deterministically on every platform.
/package.nls*.json text eol=lf
/l10n/**/*.json text eol=lf
/config/efun-docs/locales/**/*.json text eol=lf
/tests/fixtures/localization/*.json text eol=lf
/docs/i18n-efun-review/*.json text eol=lf

# Exclude development-only files from git archive exports.
src/**/__tests__/ export-ignore
tests/ export-ignore
test/ export-ignore
.spec-workflow/ export-ignore
.claude/ export-ignore

# Exclude generated/debug artifacts from archive exports.
dist/*.map export-ignore
src/antlr/*.interp export-ignore
