{
    "Create Function": {
        "prefix": "func",
        "body": [
            "${1:void} ${2:function_name}(${3:args}) {",
            "    ${0}",
            "}"
        ],
        "description": "创建新函数"
    },
    "Create Object": {
        "prefix": "obj",
        "body": [
            "#include <std.h>",
            "",
            "inherit OBJECT;",
            "",
            "void create() {",
            "    ::create();",
            "    set_name(\"${1:name}\");",
            "    set_id(({}));",
            "    ${0}",
            "}"
        ],
        "description": "创建新对象"
    },
    "Create Room": {
        "prefix": "room",
        "body": [
            "#include <std.h>",
            "",
            "inherit ROOM;",
            "",
            "void create() {",
            "    ::create();",
            "    set_light(1);",
            "    set_short(\"${1:short description}\");",
            "    set_long(\"${2:long description}\");",
            "    set_exits(([",
            "        \"${3:direction}\" : \"${4:destination}\",",
            "    ]));",
            "    ${0}",
            "}"
        ],
        "description": "创建新房间"
    },
    "Create NPC": {
        "prefix": "npc",
        "body": [
            "#include <std.h>",
            "",
            "inherit MONSTER;",
            "",
            "void create() {",
            "    ::create();",
            "    set_name(\"${1:name}\");",
            "    set_id(({\"${2:id}\"}));",
            "    set_short(\"${3:short description}\");",
            "    set_long(\"${4:long description}\");",
            "    set_level(${5:1});",
            "    set_max_hp(${6:100});",
            "    set_hp(${6:100});",
            "    ${0}",
            "}"
        ],
        "description": "创建新的 NPC"
    },
    "Create Item": {
        "prefix": "item",
        "body": [
            "#include <std.h>",
            "",
            "inherit ITEM;",
            "",
            "void create() {",
            "    ::create();",
            "    set_name(\"${1:name}\");",
            "    set_id(({\"${2:id}\"}));",
            "    set_short(\"${3:short description}\");",
            "    set_long(\"${4:long description}\");",
            "    set_value(${5:0});",
            "    set_weight(${6:1});",
            "    ${0}",
            "}"
        ],
        "description": "创建新物品"
    },
    "Create Weapon": {
        "prefix": "weapon",
        "body": [
            "#include <std.h>",
            "#include <weapon.h>",
            "",
            "inherit WEAPON;",
            "",
            "void create() {",
            "    ::create();",
            "    set_name(\"${1:name}\");",
            "    set_id(({\"${2:id}\"}));",
            "    set_short(\"${3:short description}\");",
            "    set_long(\"${4:long description}\");",
            "    set_type(\"${5:sword}\");",
            "    set_weapon_bonus(${6:1});",
            "    set_weight(${7:1});",
            "    set_value(${8:100});",
            "    ${0}",
            "}"
        ],
        "description": "创建新武器"
    },
    "Create Armor": {
        "prefix": "armor",
        "body": [
            "#include <std.h>",
            "#include <armor.h>",
            "",
            "inherit ARMOR;",
            "",
            "void create() {",
            "    ::create();",
            "    set_name(\"${1:name}\");",
            "    set_id(({\"${2:id}\"}));",
            "    set_short(\"${3:short description}\");",
            "    set_long(\"${4:long description}\");",
            "    set_type(\"${5:armor}\");",
            "    set_armor_bonus(${6:1});",
            "    set_weight(${7:1});",
            "    set_value(${8:100});",
            "    ${0}",
            "}"
        ],
        "description": "创建新防具"
    },
    "Add Action": {
        "prefix": "action",
        "body": [
            "void init() {",
            "    ::init();",
            "    add_action(\"${1:do_action}\", \"${2:command}\");",
            "}",
            "",
            "int ${1:do_action}(string arg) {",
            "    ${0}",
            "    return 1;",
            "}"
        ],
        "description": "添加新的命令动作"
    },
    "Create Apply": {
        "prefix": "apply",
        "body": [
            "int ${1:apply_name}(object who) {",
            "    ${0}",
            "    return 1;",
            "}"
        ],
        "description": "创建 apply 函数"
    }
}
