{
  "name": "lpc-support",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.52.20",
  "publisher": "ludexiang",
  "author": {
    "name": "easyCat",
    "url": "https://github.com/lude2001"
  },
  "homepage": "https://github.com/lude2001/lpc-support#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lude2001/lpc-support.git"
  },
  "bugs": {
    "url": "https://github.com/lude2001/lpc-support/issues"
  },
  "keywords": [
    "lpc",
    "fluffos",
    "mud",
    "lpmud",
    "language-support",
    "syntax-highlighting",
    "code-completion",
    "programming-language"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:lpc",
    "workspaceContains:**/lpc-support.json",
    "workspaceContains:config.hell",
    "workspaceContains:**/config.hell",
    "workspaceContains:**/*.lpc"
  ],
  "dependencies": {
    "axios": "^1.16.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.x",
    "@types/vscode": "^1.82.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.2",
    "cheerio": "^1.2.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.5",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jsdom": "^24.1.3",
    "rimraf": "^5.0.10",
    "tree-sitter-cli": "^0.27.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "overrides": {
    "follow-redirects": "1.16.0",
    "handlebars": "4.7.9",
    "picomatch": "2.3.2",
    "undici": "7.28.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "lpc",
        "aliases": [
          "LPC",
          "lpc"
        ],
        "extensions": [
          ".c",
          ".h",
          ".lpc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lpc",
        "scopeName": "source.lpc",
        "path": "./syntaxes/lpc.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[lpc]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "snippets": [
      {
        "language": "lpc",
        "path": "%snippetPath%"
      }
    ],
    "commands": [
      {
        "command": "lpc.startDriver",
        "title": "%commands.lpc.startDriver.title%",
        "category": "%commands.category.lpc%"
      },
      {
        "command": "lpc.showVariables",
        "title": "%commands.lpc.showVariables.title%"
      },
      {
        "command": "lpc.scanFolder",
        "title": "%commands.lpc.scanFolder.title%",
        "category": "%commands.category.lpc%"
      },
      {
        "command": "lpc.compileFile",
        "title": "%commands.lpc.compileFile.title%",
        "category": "%commands.category.lpc%"
      },
      {
        "command": "lpc.compileFolder",
        "title": "%commands.lpc.compileFolder.title%",
        "category": "%commands.category.lpc%"
      },
      {
        "command": "lpc.manageCompilation",
        "title": "%commands.lpc.manageCompilation.title%",
        "category": "%commands.category.lpc%"
      },
      {
        "command": "lpc.configureSimulatedEfuns",
        "title": "%commands.lpc.configureSimulatedEfuns.title%",
        "category": "%commands.category.lpc%"
      },
      {
        "command": "lpc.initProjectConfig",
        "title": "%commands.lpc.initProjectConfig.title%",
        "category": "%commands.category.lpc%"
      },
      {
        "command": "lpc.showFunctionDoc",
        "title": "%commands.lpc.showFunctionDoc.title%",
        "category": "%commands.category.lpc%",
        "icon": {
          "light": "./media/function-doc-light.svg",
          "dark": "./media/function-doc-dark.svg"
        }
      },
      {
        "command": "lpc.showAnalysisInspector",
        "title": "%commands.lpc.showAnalysisInspector.title%",
        "category": "%commands.category.lpc%",
        "icon": "$(inspect)"
      },
      {
        "command": "lpc.rebuildWorkspaceIndex",
        "title": "%commands.lpc.rebuildWorkspaceIndex.title%",
        "category": "%commands.category.lpc%"
      },
      {
        "command": "lpc.generateJavadoc",
        "title": "%commands.lpc.generateJavadoc.title%",
        "category": "%commands.category.lpc%"
      },
      {
        "command": "lpc.errorTree.refresh",
        "title": "%commands.lpc.errorTree.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "lpc.errorTree.clear",
        "title": "%commands.lpc.errorTree.clear.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "lpc.errorTree.openErrorLocation",
        "title": "%commands.lpc.errorTree.openErrorLocation.title%"
      },
      {
        "command": "lpc.errorTree.copyError",
        "title": "%commands.lpc.errorTree.copyError.title%",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lpc.errorTree.refresh",
          "when": "view == lpcErrorTree",
          "group": "navigation@1"
        },
        {
          "command": "lpc.errorTree.clear",
          "when": "view == lpcErrorTree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "lpc.errorTree.copyError",
          "when": "view == lpcErrorTree && viewItem == errorItem",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == lpc",
          "command": "lpc.compileFile",
          "group": "LPC"
        },
        {
          "when": "resourceLangId == lpc",
          "command": "lpc.manageCompilation",
          "group": "LPC"
        },
        {
          "when": "resourceLangId == lpc",
          "command": "lpc.generateJavadoc",
          "group": "LPC"
        }
      ],
      "explorer/context": [
        {
          "command": "lpc.scanFolder",
          "group": "LPC"
        },
        {
          "command": "lpc.compileFolder",
          "group": "LPC",
          "when": "explorerResourceIsFolder"
        }
      ],
      "editor/title": [
        {
          "command": "lpc.showAnalysisInspector",
          "when": "resourceLangId == lpc",
          "group": "navigation@2"
        },
        {
          "command": "lpc.showFunctionDoc",
          "when": "resourceLangId == lpc",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lpc-activitybar",
          "title": "%viewsContainers.lpc-activitybar.title%",
          "icon": "media/function-doc-dark.svg"
        }
      ]
    },
    "views": {
      "lpc-activitybar": [
        {
          "id": "lpcErrorTree",
          "name": "%views.lpcErrorTree.name%",
          "type": "tree",
          "icon": "$(error)"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "lpc.enableUnusedGlobalVarCheck": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.lpc.enableUnusedGlobalVarCheck.description%"
        },
        "lpc.enableUnusedParameterCheck": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.lpc.enableUnusedParameterCheck.description%"
        },
        "lpc.enforceLocalVariableDeclarationAtBlockStart": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.lpc.enforceLocalVariableDeclarationAtBlockStart.description%"
        },
        "lpc.searchEfunDefinitionInInheritanceChain": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.lpc.searchEfunDefinitionInInheritanceChain.description%"
        },
        "lpc.enableTypeChecking": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.lpc.enableTypeChecking.description%"
        },
        "lpc.format.indentSize": {
          "type": "integer",
          "default": 4,
          "minimum": 2,
          "maximum": 8,
          "description": "%configuration.lpc.format.indentSize.description%"
        },
        "lpc.format.printWidth": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "maximum": 400,
          "description": "%configuration.lpc.format.printWidth.description%"
        },
        "lpc.format.braceStyle": {
          "type": "string",
          "enum": [
            "allman",
            "kr"
          ],
          "enumDescriptions": [
            "%configuration.lpc.format.braceStyle.enumDescriptions.allman%",
            "%configuration.lpc.format.braceStyle.enumDescriptions.kr%"
          ],
          "default": "allman",
          "description": "%configuration.lpc.format.braceStyle.description%"
        },
        "lpc.glm4.apiKey": {
          "type": "string",
          "default": "",
          "description": "%configuration.lpc.glm4.apiKey.description%"
        },
        "lpc.glm4.model": {
          "type": "string",
          "default": "GLM-4-Flash-250414",
          "description": "%configuration.lpc.glm4.model.description%"
        },
        "lpc.glm4.allowCustomModel": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.lpc.glm4.allowCustomModel.description%"
        },
        "lpc.glm4.baseUrl": {
          "type": "string",
          "default": "https://open.bigmodel.cn/api/paas/v4",
          "description": "%configuration.lpc.glm4.baseUrl.description%"
        },
        "lpc.glm4.timeout": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "%configuration.lpc.glm4.timeout.description%"
        },
        "lpc.javadoc.enableAutoGeneration": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.lpc.javadoc.enableAutoGeneration.description%"
        },
        "lpc.glm4.alwaysShowModelSelector": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.lpc.glm4.alwaysShowModelSelector.description%"
        },
        "lpc.glm4.rememberLastModel": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.lpc.glm4.rememberLastModel.description%"
        },
        "lpc.glm4.lastSelectedModel": {
          "type": "string",
          "default": "",
          "description": "%configuration.lpc.glm4.lastSelectedModel.description%"
        },
        "lpc.glm4.customModels": {
          "type": "array",
          "default": [],
          "description": "%configuration.lpc.glm4.customModels.description%",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%configuration.lpc.glm4.customModels.items.name.description%"
              },
              "id": {
                "type": "string",
                "description": "%configuration.lpc.glm4.customModels.items.id.description%"
              },
              "description": {
                "type": "string",
                "description": "%configuration.lpc.glm4.customModels.items.description.description%"
              }
            },
            "required": [
              "name",
              "id"
            ]
          }
        },
        "lpc.documentation.language": {
          "type": "string",
          "enum": [
            "zh-cn",
            "en"
          ],
          "default": "zh-cn",
          "scope": "resource",
          "description": "%configuration.lpc.documentation.language.description%",
          "enumDescriptions": [
            "%configuration.lpc.documentation.language.enumDescriptions.zh-cn%",
            "%configuration.lpc.documentation.language.enumDescriptions.en%"
          ]
        }
      }
    },
    "keybindings": [
      {
        "command": "editor.action.commentLine",
        "key": "ctrl+/",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'lpc'"
      },
      {
        "command": "editor.action.blockComment",
        "key": "shift+alt+a",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'lpc'"
      },
      {
        "command": "lpc.compileFile",
        "key": "ctrl+f5",
        "when": "editorTextFocus && editorLangId == 'lpc'"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "keyword",
        "description": "%semanticTokenTypes.keyword.description%"
      },
      {
        "id": "lpcType",
        "superType": "type",
        "description": "%semanticTokenTypes.lpcType.description%"
      },
      {
        "id": "type",
        "description": "%semanticTokenTypes.type.description%"
      },
      {
        "id": "variable",
        "description": "%semanticTokenTypes.variable.description%"
      },
      {
        "id": "parameter",
        "description": "%semanticTokenTypes.parameter.description%"
      },
      {
        "id": "function",
        "description": "%semanticTokenTypes.function.description%"
      },
      {
        "id": "method",
        "superType": "function",
        "description": "%semanticTokenTypes.method.description%"
      },
      {
        "id": "property",
        "superType": "variable",
        "description": "%semanticTokenTypes.property.description%"
      },
      {
        "id": "macro",
        "description": "%semanticTokenTypes.macro.description%"
      },
      {
        "id": "number",
        "description": "%semanticTokenTypes.number.description%"
      },
      {
        "id": "string",
        "description": "%semanticTokenTypes.string.description%"
      },
      {
        "id": "comment",
        "description": "%semanticTokenTypes.comment.description%"
      },
      {
        "id": "operator",
        "description": "%semanticTokenTypes.operator.description%"
      },
      {
        "id": "builtin",
        "superType": "function",
        "description": "%semanticTokenTypes.builtin.description%"
      },
      {
        "id": "simulatedEfun",
        "superType": "function",
        "description": "%semanticTokenTypes.simulatedEfun.description%"
      },
      {
        "id": "inactive",
        "superType": "comment",
        "description": "%semanticTokenTypes.inactive.description%"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "declaration",
        "description": "%semanticTokenModifiers.declaration.description%"
      },
      {
        "id": "local",
        "description": "%semanticTokenModifiers.local.description%"
      },
      {
        "id": "defaultLibrary",
        "description": "%semanticTokenModifiers.defaultLibrary.description%"
      },
      {
        "id": "readonly",
        "description": "%semanticTokenModifiers.readonly.description%"
      },
      {
        "id": "static",
        "description": "%semanticTokenModifiers.static.description%"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "lpc",
        "scopes": {
          "lpcType": [
            "support.type.primitive.lpc"
          ],
          "method": [
            "entity.name.function.member.lpc"
          ],
          "macro": [
            "entity.name.function.preprocessor.lpc"
          ],
          "builtin": [
            "support.function.efun.lpc"
          ],
          "simulatedEfun": [
            "support.function.simulated-efun.lpc"
          ],
          "inactive": [
            "comment.block.preprocessor.lpc"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "cross-env NODE_ENV=production npm run build && npm run build:rust && node scripts/prepare-native-package.mjs",
    "build": "node esbuild.mjs",
    "build:l10n": "node scripts/localization/build-bundles.mjs --write",
    "check:l10n": "node scripts/localization/build-bundles.mjs --check && node scripts/localization/efun-baseline.mjs --check && node scripts/localization/check-efun-localization.mjs",
    "test:l10n": "node --test scripts/localization/build-bundles.test.mjs scripts/localization/efun-baseline.test.mjs scripts/localization/manifest-localization.test.mjs scripts/tests/localization-text-inventory.test.mjs scripts/localization/check-efun-localization.test.mjs scripts/localization/check-vsix-localization.test.mjs",
    "build:rust": "node scripts/build-rust-lsp.mjs",
    "benchmark:rust": "node scripts/run-cargo.mjs run --manifest-path rust/Cargo.toml --release --package lpc-language-server --example analysis-benchmark --",
    "check:rust": "node scripts/run-cargo.mjs clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
    "test:rust": "node scripts/run-cargo.mjs test --manifest-path rust/Cargo.toml --workspace",
    "test:rust-formatter": "node scripts/run-cargo.mjs run --manifest-path rust/Cargo.toml --package lpc-language-server --example formatter-check -- test/lpc_code/yifeng-jian.c test/lpc_code/meridiand.c",
    "build:dev": "cross-env NODE_ENV=development npm run build",
    "watch": "cross-env NODE_ENV=development node esbuild.mjs --watch",
    "package": "npm run clean && node scripts/package-extension.mjs",
    "clean": "rimraf dist out",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "check:all": "tsc --noEmit",
    "analyze": "cross-env NODE_ENV=development npm run build -- --analyze",
    "test": "jest",
    "test:unit": "jest --runInBand src",
    "test:e2e": "node scripts/run-vscode-lifecycle-test.mjs",
    "test:vscode-navigation": "node scripts/run-vscode-navigation-test.mjs",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:performance": "jest --runInBand src/functionDocs/__tests__/FunctionDocumentationPerformance.test.ts",
    "test:rust-smoke": "node scripts/rust-lsp-smoke.mjs",
    "test:rust-localization": "node scripts/localization/rust-localization-smoke.mjs",
    "test:ci-tools": "node --test scripts/tests/diagnostics-inbox.test.mjs",
    "probe:lsp": "node scripts/lsp-probe.mjs",
    "audit:efun-arity": "node scripts/audit-efun-arity.mjs",
    "audit:efun-arity:strict": "node scripts/audit-efun-arity.mjs --strict",
    "audit:efun-arity:strict-arity": "node scripts/audit-efun-arity.mjs --strict-arity",
    "audit:rust-syntax": "node scripts/run-cargo.mjs run --manifest-path rust/Cargo.toml --release --package lpc-language-server --example syntax_audit --",
    "test:efun-localization-consumers": "node scripts/localization/check-efun-consumers.mjs",
    "check:vsix-localization": "node scripts/localization/check-vsix-localization.mjs",
    "test:vscode-localization": "node scripts/run-vscode-localization-test.mjs"
  },
  "license": "MIT",
  "icon": "icon.png",
  "files": [
    "dist/**",
    "syntaxes/**",
    "snippets/**",
    "media/**",
    "language-configuration.json",
    "config/efun-docs/**",
    "docs/rust-lsp-troubleshooting.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "icon.png",
    "LICENSE",
    "package.nls*.json",
    "l10n/bundle.l10n*.json"
  ],
  "l10n": "./l10n"
}
