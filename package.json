{
  "name": "lpc-support",
  "displayName": "LPC[FluffOS]",
  "description": "LPC (LP MUD Creation Language) 语言支持",
  "version": "0.52.13",
  "publisher": "ludexiang",
  "author": {
    "name": "easyCat",
    "url": "https://github.com/lude2001"
  },
  "homepage": "https://github.com/lude2001/lpc-support#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lude2001/lpc-support.git"
  },
  "bugs": {
    "url": "https://github.com/lude2001/lpc-support/issues"
  },
  "keywords": [
    "lpc",
    "fluffos",
    "mud",
    "lpmud",
    "language-support",
    "syntax-highlighting",
    "code-completion",
    "programming-language"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:lpc",
    "workspaceContains:**/lpc-support.json",
    "workspaceContains:config.hell",
    "workspaceContains:**/config.hell",
    "workspaceContains:**/*.lpc"
  ],
  "dependencies": {
    "axios": "^1.16.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.x",
    "@types/vscode": "^1.82.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.2",
    "cheerio": "^1.2.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.5",
    "esbuild-node-externals": "^1.18.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jsdom": "^24.1.3",
    "rimraf": "^5.0.10",
    "tree-sitter-cli": "^0.27.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "follow-redirects": "1.16.0",
    "handlebars": "4.7.9",
    "picomatch": "2.3.2",
    "undici": "7.28.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "lpc",
        "aliases": [
          "LPC",
          "lpc"
        ],
        "extensions": [
          ".c",
          ".h",
          ".lpc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lpc",
        "scopeName": "source.lpc",
        "path": "./syntaxes/lpc.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[lpc]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "snippets": [
      {
        "language": "lpc",
        "path": "./snippets/lpc.json"
      }
    ],
    "commands": [
      {
        "command": "lpc.startDriver",
        "title": "启动MUD驱动",
        "category": "LPC"
      },
      {
        "command": "lpc.showVariables",
        "title": "显示所有 LPC 变量"
      },
      {
        "command": "lpc.scanFolder",
        "title": "扫描文件夹中未使用的变量",
        "category": "LPC"
      },
      {
        "command": "lpc.compileFile",
        "title": "编译LPC文件",
        "category": "LPC"
      },
      {
        "command": "lpc.compileFolder",
        "title": "批量编译LPC文件",
        "category": "LPC"
      },
      {
        "command": "lpc.manageCompilation",
        "title": "编译管理",
        "category": "LPC"
      },
      {
        "command": "lpc.configureSimulatedEfuns",
        "title": "查看模拟函数入口配置来源",
        "category": "LPC"
      },
      {
        "command": "lpc.initProjectConfig",
        "title": "初始化 LPC 项目配置",
        "category": "LPC"
      },
      {
        "command": "lpc.showFunctionDoc",
        "title": "显示函数文档面板",
        "category": "LPC",
        "icon": {
          "light": "./media/function-doc-light.svg",
          "dark": "./media/function-doc-dark.svg"
        }
      },
      {
        "command": "lpc.rebuildWorkspaceIndex",
        "title": "重建 LPC 工作区索引",
        "category": "LPC"
      },
      {
        "command": "lpc.generateJavadoc",
        "title": "生成Javadoc注释",
        "category": "LPC"
      },
      {
        "command": "lpc.errorTree.refresh",
        "title": "刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "lpc.errorTree.clear",
        "title": "清空所有错误",
        "icon": "$(clear-all)"
      },
      {
        "command": "lpc.errorTree.openErrorLocation",
        "title": "打开错误位置"
      },
      {
        "command": "lpc.errorTree.copyError",
        "title": "复制错误信息",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lpc.errorTree.refresh",
          "when": "view == lpcErrorTree",
          "group": "navigation@1"
        },
        {
          "command": "lpc.errorTree.clear",
          "when": "view == lpcErrorTree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "lpc.errorTree.copyError",
          "when": "view == lpcErrorTree && viewItem == errorItem",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == lpc",
          "command": "lpc.compileFile",
          "group": "LPC"
        },
        {
          "when": "resourceLangId == lpc",
          "command": "lpc.manageCompilation",
          "group": "LPC"
        },
        {
          "when": "resourceLangId == lpc",
          "command": "lpc.generateJavadoc",
          "group": "LPC"
        }
      ],
      "explorer/context": [
        {
          "command": "lpc.scanFolder",
          "group": "LPC"
        },
        {
          "command": "lpc.compileFolder",
          "group": "LPC",
          "when": "explorerResourceIsFolder"
        }
      ],
      "editor/title": [
        {
          "command": "lpc.showFunctionDoc",
          "when": "resourceLangId == lpc",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lpc-activitybar",
          "title": "LPC",
          "icon": "media/function-doc-dark.svg"
        }
      ]
    },
    "views": {
      "lpc-activitybar": [
        {
          "id": "lpcErrorTree",
          "name": "错误诊断中心",
          "type": "tree",
          "icon": "$(error)"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "LPC Support Configuration",
      "properties": {
        "lpc.enableUnusedGlobalVarCheck": {
          "type": "boolean",
          "default": false,
          "description": "启用未使用的全局变量检查。默认关闭，以避免 LPC 继承链和头文件共享变量导致的误报。"
        },
        "lpc.enableUnusedParameterCheck": {
          "type": "boolean",
          "default": false,
          "description": "启用未使用的函数参数检查。只检查带函数体的实现并忽略下划线前缀参数；默认关闭，以避免回调和覆盖函数的约定参数产生噪声。"
        },
        "lpc.enforceLocalVariableDeclarationAtBlockStart": {
          "type": "boolean",
          "default": false,
          "description": "启用“局部变量定义必须在可执行语句或代码块开头”的检查。FluffOS 新版本通常不需要此限制。"
        },
        "lpc.searchEfunDefinitionInInheritanceChain": {
          "type": "boolean",
          "default": false,
          "description": "对 efun（驱动内置函数）调用执行“转到定义”时是否搜索继承链。默认关闭：efun 调用直接返回“未找到”，避免遍历继承链带来的延迟。仅当你在继承链（而非模拟函数库 simul_efun）中重写了 efun 时才需要开启。"
        },
        "lpc.enableTypeChecking": {
          "type": "boolean",
          "default": true,
          "description": "启用保守的 LPC 类型检查诊断。关闭后不会产生 lpc.type.* 诊断。"
        },
        "lpc.format.indentSize": {
          "type": "number",
          "default": 4,
          "minimum": 2,
          "maximum": 8,
          "description": "LPC formatter indentation size"
        },
        "lpc.glm4.apiKey": {
          "type": "string",
          "default": "",
          "description": "智谱AI GLM-4 API密钥，用于生成Javadoc注释"
        },
        "lpc.glm4.model": {
          "type": "string",
          "default": "GLM-4-Flash-250414",
          "description": "GLM-4模型类型，支持预设模型或自定义模型名称。预设模型包括: glm-4, glm-4-flash, glm-z1-flash, GLM-4.5-Flash, GLM-4-Flash-250414"
        },
        "lpc.glm4.allowCustomModel": {
          "type": "boolean",
          "default": true,
          "description": "允许用户在生成Javadoc时选择自定义模型"
        },
        "lpc.glm4.baseUrl": {
          "type": "string",
          "default": "https://open.bigmodel.cn/api/paas/v4",
          "description": "GLM-4 API基础URL"
        },
        "lpc.glm4.timeout": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "API请求超时时间（毫秒）"
        },
        "lpc.javadoc.enableAutoGeneration": {
          "type": "boolean",
          "default": true,
          "description": "启用自动生成Javadoc注释功能"
        },
        "lpc.glm4.alwaysShowModelSelector": {
          "type": "boolean",
          "default": false,
          "description": "每次生成Javadoc时都显示模型选择界面，关闭后将直接使用默认模型"
        },
        "lpc.glm4.rememberLastModel": {
          "type": "boolean",
          "default": true,
          "description": "记住上次选择的模型，下次生成时优先使用"
        },
        "lpc.glm4.lastSelectedModel": {
          "type": "string",
          "default": "",
          "description": "上次选择的模型名称（自动保存）"
        },
        "lpc.glm4.customModels": {
          "type": "array",
          "default": [],
          "description": "用户自定义的模型列表",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "模型显示名称"
              },
              "id": {
                "type": "string",
                "description": "模型ID"
              },
              "description": {
                "type": "string",
                "description": "模型描述"
              }
            },
            "required": [
              "name",
              "id"
            ]
          }
        }
      }
    },
    "keybindings": [
      {
        "command": "editor.action.commentLine",
        "key": "ctrl+/",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'lpc'"
      },
      {
        "command": "editor.action.blockComment",
        "key": "shift+alt+a",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'lpc'"
      },
      {
        "command": "lpc.compileFile",
        "key": "ctrl+f5",
        "when": "editorTextFocus && editorLangId == 'lpc'"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "keyword",
        "description": "关键字"
      },
      {
        "id": "lpcType",
        "superType": "type",
        "description": "LPC 基础类型"
      },
      {
        "id": "type",
        "description": "类型关键字"
      },
      {
        "id": "variable",
        "description": "变量"
      },
      {
        "id": "parameter",
        "description": "函数参数"
      },
      {
        "id": "function",
        "description": "函数名"
      },
      {
        "id": "method",
        "superType": "function",
        "description": "对象方法"
      },
      {
        "id": "property",
        "superType": "variable",
        "description": "成员/属性"
      },
      {
        "id": "macro",
        "description": "宏或常量"
      },
      {
        "id": "number",
        "description": "数字"
      },
      {
        "id": "string",
        "description": "字符串"
      },
      {
        "id": "comment",
        "description": "注释"
      },
      {
        "id": "operator",
        "description": "运算符"
      },
      {
        "id": "builtin",
        "superType": "function",
        "description": "内置函数"
      },
      {
        "id": "simulatedEfun",
        "superType": "function",
        "description": "模拟外部函数"
      },
      {
        "id": "inactive",
        "superType": "comment",
        "description": "未启用的条件编译代码"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "declaration",
        "description": "声明位置"
      },
      {
        "id": "local",
        "description": "局部符号"
      },
      {
        "id": "defaultLibrary",
        "description": "内置库符号"
      },
      {
        "id": "readonly",
        "description": "只读符号"
      },
      {
        "id": "static",
        "description": "静态符号"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "lpc",
        "scopes": {
          "lpcType": [
            "support.type.primitive.lpc"
          ],
          "method": [
            "entity.name.function.member.lpc"
          ],
          "macro": [
            "entity.name.function.preprocessor.lpc"
          ],
          "builtin": [
            "support.function.efun.lpc"
          ],
          "simulatedEfun": [
            "support.function.simulated-efun.lpc"
          ],
          "inactive": [
            "comment.block.preprocessor.lpc"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "cross-env NODE_ENV=production npm run build && npm run build:rust && node scripts/prepare-native-package.mjs",
    "build": "node esbuild.mjs",
    "build:rust": "node scripts/build-rust-lsp.mjs",
    "benchmark:rust": "node scripts/run-cargo.mjs run --manifest-path rust/Cargo.toml --release --package lpc-language-server --example analysis-benchmark --",
    "check:rust": "node scripts/run-cargo.mjs clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
    "test:rust": "node scripts/run-cargo.mjs test --manifest-path rust/Cargo.toml --workspace",
    "test:rust-formatter": "node scripts/run-cargo.mjs run --manifest-path rust/Cargo.toml --package lpc-language-server --example formatter-check -- test/lpc_code/yifeng-jian.c test/lpc_code/meridiand.c",
    "build:dev": "cross-env NODE_ENV=development npm run build",
    "watch": "cross-env NODE_ENV=development node esbuild.mjs --watch",
    "package": "npm run clean && node scripts/package-extension.mjs",
    "clean": "rimraf dist out",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "check:all": "tsc --noEmit",
    "analyze": "cross-env NODE_ENV=development npm run build -- --analyze",
    "test": "jest",
    "test:unit": "jest --runInBand src",
    "test:e2e": "node scripts/run-vscode-lifecycle-test.mjs",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:performance": "jest --runInBand src/functionDocs/__tests__/FunctionDocumentationPerformance.test.ts",
    "test:rust-smoke": "node scripts/rust-lsp-smoke.mjs",
    "probe:lsp": "node scripts/lsp-probe.mjs",
    "audit:efun-arity": "node scripts/audit-efun-arity.mjs",
    "audit:efun-arity:strict": "node scripts/audit-efun-arity.mjs --strict",
    "audit:efun-arity:strict-arity": "node scripts/audit-efun-arity.mjs --strict-arity",
    "audit:rust-syntax": "node scripts/run-cargo.mjs run --manifest-path rust/Cargo.toml --release --package lpc-language-server --example syntax_audit --"
  },
  "license": "MIT",
  "icon": "icon.png",
  "files": [
    "dist/**",
    "syntaxes/**",
    "snippets/**",
    "media/**",
    "language-configuration.json",
    "config/**",
    "docs/efun-arity-audit.md",
    "docs/rust-lsp-troubleshooting.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "icon.png",
    "LICENSE"
  ]
}
